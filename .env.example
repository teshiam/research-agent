# ---------- Storage ----------
DB_PATH=research.db

# ---------- How the agent thinks ----------
# FREE, no key needed: scripted plan + extractive report.
LLM_PROVIDER=heuristic

# --- Free real-LLM options (OpenAI-compatible). Uncomment ONE block. ---
# Free-tier limits and model names change often, so check each provider's page.
#
# Groq (key: https://console.groq.com/keys)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-groq-key
# LLM_MODEL=llama-3.3-70b-versatile
#
# Google Gemini (key: https://aistudio.google.com/apikey)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-2.5-flash
#
# OpenRouter (key: https://openrouter.ai/keys, models ending in :free)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your-openrouter-key
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# Ollama, fully local and offline (install from https://ollama.com, then `ollama pull llama3.2`)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
#
# Paid option: Claude
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key
# LLM_MODEL=claude-sonnet-5-5

# Optional: price per million tokens, to show a cost estimate (free tiers: leave at 0)
INPUT_PRICE_PER_MTOK=0
OUTPUT_PRICE_PER_MTOK=0

# ---------- Where the agent searches ----------
# wikipedia (default): free, no key, very reliable
# duckduckgo: whole web, no key (pip install -e ".[ddg]"; scrapes, so it can rate-limit)
# searxng: your own metasearch instance (needs JSON output enabled)
SEARCH_PROVIDER=wikipedia
# SEARXNG_URL=https://your-searxng.example
# Wikipedia asks API clients to identify themselves. Put your contact details here:
USER_AGENT=ResearchAgent/0.1 (portfolio project; contact: you@example.com)

# ---------- Budgets and safety ----------
MAX_CONCURRENT_RUNS=2
RUN_TIMEOUT_SECONDS=240
MAX_TOTAL_TOKENS=60000
# Keep false: it is what blocks the agent from fetching localhost and internal networks.
ALLOW_PRIVATE_HOSTS=false

# ---------- CORS (comma-separated; add your deployed frontend URL) ----------
CORS_ORIGINS=http://localhost:3000
